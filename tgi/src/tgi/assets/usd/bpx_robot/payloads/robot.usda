#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "bpx"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "bpx" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "torso" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_hip_roll_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "fl_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fl_hip_pitch_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "fl_calf_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fl_knee_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "fl_toe_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "PhysicsFixedJoint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "fr_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_hip_roll_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "fr_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fr_hip_pitch_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "fr_calf_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "fr_knee_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "fr_toe_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "PhysicsFixedJoint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "hl_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hl_hip_roll_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "hl_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hl_hip_pitch_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "hl_calf_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "hl_knee_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "hl_toe_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "PhysicsFixedJoint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "hr_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hr_hip_roll_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "hr_thigh_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hr_hip_pitch_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "hr_calf_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "hr_knee_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "hr_toe_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "PhysicsFixedJoint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "backplate" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "enclosure_wall" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "PhysicsFixedJoint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }

                over "lid" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
