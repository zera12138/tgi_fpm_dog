                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "cam_bracket" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "PhysicsFixedJoint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "zed_front_camera_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "PhysicsFixedJoint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "zed_front_camera_center" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "PhysicsFixedJoint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }

                            over "zed_front_left_camera_frame" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "PhysicsFixedJoint" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
                                )
                                {
                                }

                                over "zed_front_left_camera_frame_optical" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "PhysicsFixedJoint" (
                                        prepend apiSchemas = ["IsaacJointAPI"]
                                    )
                                    {
                                    }
                                }

                                over "zed_front_imu_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "PhysicsFixedJoint" (
                                        prepend apiSchemas = ["IsaacJointAPI"]
                                    )
                                    {
                                    }
                                }
                            }

                            over "zed_front_right_camera_frame" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "PhysicsFixedJoint" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
