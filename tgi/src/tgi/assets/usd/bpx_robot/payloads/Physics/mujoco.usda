#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "bpx"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "bpx"
{
    over "Geometry"
    {
        over "torso"
        {
            over "torso_collision_0" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 3
                uniform double[] mjc:solref = [0.01, 1]
            }

            over "torso_collision_1" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 3
                uniform double[] mjc:solref = [0.01, 1]
            }

            over "torso_collision_2" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 3
                uniform double[] mjc:solref = [0.01, 1]
            }

            over "torso_collision_3" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 3
                uniform double[] mjc:solref = [0.01, 1]
            }

            over "fl_hip_link"
            {
                over "fl_thigh_link"
                {
                    over "fl_thigh_link_collision_0" (
                        prepend apiSchemas = ["MjcCollisionAPI"]
                    )
