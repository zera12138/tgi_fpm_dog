                        uniform int mjc:group = 3
                        uniform double[] mjc:solref = [0.01, 1]
                    }

                    over "fl_thigh_link_collision_1" (
                        prepend apiSchemas = ["MjcCollisionAPI"]
                    )
                    {
                        uniform int mjc:group = 3
                        uniform double[] mjc:solref = [0.01, 1]
                    }

                    over "fl_calf_link"
                    {
                        over "fl_calf_link_collision_0" (
                            prepend apiSchemas = ["MjcCollisionAPI"]
                        )
                        {
                            uniform int mjc:group = 3
                            uniform double[] mjc:solref = [0.01, 1]
                        }

                        over "fl_calf_link_collision_1" (
                            prepend apiSchemas = ["MjcCollisionAPI"]
                        )
                        {
                            uniform int mjc:group = 3
                            uniform double[] mjc:solref = [0.01, 1]
                        }

                        over "fl_toe_link"
                        {
                            over "fl_toe_link_collision_0" (
                                prepend apiSchemas = ["MjcCollisionAPI"]
                            )
                            {
                                uniform int mjc:group = 3
                                uniform double[] mjc:solref = [0.01, 1]
                            }

                            over "fl_foot" (
                                prepend apiSchemas = ["MjcSiteAPI"]
                            )
                            {
                            }
                        }

                        over "fl_knee_joint" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                        }
                    }

                    over "fl_hip_pitch_joint" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                    }
                }

                over "fl_hip_roll_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                }
            }

            over "fr_hip_link"
            {
                over "fr_thigh_link"
                {
                    over "fr_thigh_link_collision_0" (
