                        }

                        over "hr_toe_link"
                        {
                            over "hr_toe_link_collision_0" (
                                prepend apiSchemas = ["MjcCollisionAPI"]
                            )
                            {
                                uniform int mjc:group = 3
                                uniform double[] mjc:solref = [0.01, 1]
                            }

                            over "hr_foot" (
                                prepend apiSchemas = ["MjcSiteAPI"]
                            )
                            {
                            }
                        }

                        over "hr_knee_joint" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                        }
                    }

                    over "hr_hip_pitch_joint" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                    }
                }

                over "hr_hip_roll_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                }
            }

            over "backplate"
            {
                over "backplate_collision_0" (
                    prepend apiSchemas = ["MjcCollisionAPI"]
                )
                {
                    uniform int mjc:group = 3
                    uniform double[] mjc:solref = [0.01, 1]
                }

                over "enclosure_wall"
                {
                    over "enclosure_wall_collision_0" (
