            }

            over "camera_mount_base"
            {
                over "cam_bracket"
                {
                    over "zed_front_camera_link"
                    {
                        over "zed_front_camera_center"
                        {
                            over "zed_front_camera_center_collision_0" (
                                prepend apiSchemas = ["MjcCollisionAPI"]
                            )
                            {
                                uniform int mjc:group = 3
                                uniform double[] mjc:solref = [0.01, 1]
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def MjcActuator "fl_hip_roll_joint"
        {
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </bpx/Geometry/torso/fl_hip_link/fl_hip_roll_joint>
        }

        def MjcActuator "fl_hip_pitch_joint"
        {
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </bpx/Geometry/torso/fl_hip_link/fl_thigh_link/fl_hip_pitch_joint>
        }

        def MjcActuator "fl_knee_joint"
        {
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </bpx/Geometry/torso/fl_hip_link/fl_thigh_link/fl_calf_link/fl_knee_joint>
        }

        def MjcActuator "fr_hip_roll_joint"
        {
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </bpx/Geometry/torso/fr_hip_link/fr_hip_roll_joint>
        }

        def MjcActuator "fr_hip_pitch_joint"
        {
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </bpx/Geometry/torso/fr_hip_link/fr_thigh_link/fr_hip_pitch_joint>
        }

        def MjcActuator "fr_knee_joint"
        {
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </bpx/Geometry/torso/fr_hip_link/fr_thigh_link/fr_calf_link/fr_knee_joint>
        }

        def MjcActuator "hl_hip_roll_joint"
        {
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            custom rel mjc:target
            append rel mjc:target = </bpx/Geometry/torso/hl_hip_link/hl_hip_roll_joint>
        }

